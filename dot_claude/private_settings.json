{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "plan"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR\"; [ -n \"$d\" ] && [ \"$d\" != \"$HOME\" ] && cd \"$d\" || exit 0; n=$( { find . -maxdepth 1 -name '.*' -type f -empty -perm 0444 -print -delete; [ -d .claude ] && find .claude -maxdepth 1 -type f -empty -perm 0444 -print -delete; } 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && printf '{\"systemMessage\":\"Removed %s leftover sandbox stub file(s)\"}\\n' \"$n\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in */.claude/plans/*) exit 0;; *.md) command -v markdownlint-cli2 >/dev/null || exit 0; markdownlint-cli2 --config \"$HOME/.config/nvim/.markdownlint-cli2.yaml\" \"$f\" >&2 || exit 2;; *.sh|*.env) command -v shellcheck >/dev/null || exit 0; shellcheck \"$f\" >&2 || exit 2;; esac"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "gitkraken-hooks@gitkraken": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "gitkraken": {
      "source": {
        "source": "directory",
        "path": "/home/gadhi/.claude/plugins/marketplaces/gitkraken"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws/credentials",
        "~/.gnupg",
        "~/.netrc",
        "~/.kube"
      ]
    }
  },
  "feedbackDrafts": "notify",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "preferredNotifChannel": "kitty",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
